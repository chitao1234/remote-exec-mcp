	$(MSVC_RUN_TEST)

test-msvc-console-output: $(MSVC_CONSOLE_OUTPUT_TEST)
	$(MSVC_RUN_TEST)

test-msvc-patch: $(MSVC_PATCH_TEST)
	$(MSVC_RUN_TEST)

test-msvc-session-store: $(MSVC_SESSION_STORE_TEST)
	$(MSVC_RUN_TEST)

test-msvc-server-streaming: $(MSVC_SERVER_STREAMING_TEST)
	$(MSVC_RUN_TEST)

test-msvc-transfer: $(MSVC_TRANSFER_TEST)
	$(MSVC_RUN_TEST)

test-msvc-config: $(MSVC_CONFIG_TEST)
	$(MSVC_RUN_TEST)

test-msvc-http-request: $(MSVC_HTTP_REQUEST_TEST)
	$(MSVC_RUN_TEST)

test-msvc-server-transport: $(MSVC_SERVER_TRANSPORT_TEST)
	$(MSVC_RUN_TEST)

test-msvc-connection-manager: $(MSVC_CONNECTION_MANAGER_TEST)
	$(MSVC_RUN_TEST)

test-msvc-server-routes-common: $(MSVC_SERVER_ROUTES_COMMON_TEST)
	$(MSVC_RUN_TEST)

test-msvc-server-routes: $(MSVC_SERVER_ROUTES_TEST)
	$(MSVC_RUN_TEST)

test-msvc-server-runtime: $(MSVC_SERVER_RUNTIME_TEST)
	$(MSVC_RUN_TEST)

test-msvc-sandbox: $(MSVC_SANDBOX_TEST)
	$(MSVC_RUN_TEST)

test-msvc-port-tunnel-frame: $(MSVC_PORT_TUNNEL_FRAME_TEST)
