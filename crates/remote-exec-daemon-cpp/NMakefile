# MSVC/NMAKE entry point for remote-exec-daemon-cpp.
#
# Host-native MSVC build from a Visual Studio developer prompt:
#   nmake /f NMakefile check-msvc-native
#
# Windows XP-compatible MSVC C++11 build from an x86 Visual Studio developer
# prompt with an XP-capable toolset, for example:
#   vcvarsall.bat x86 -vcvars_ver=14.16
#   nmake /f NMakefile check-msvc-xp
#
# POSIX daemon and host-native POSIX tests remain on the GNU/BSD make paths.

!IFNDEF DAEMON_CPP_DIR
!IF EXIST(src\main.cpp)
DAEMON_CPP_DIR=.
!ELSEIF EXIST(crates\remote-exec-daemon-cpp\src\main.cpp)
DAEMON_CPP_DIR=crates\remote-exec-daemon-cpp
!ELSE
!ERROR Unable to locate remote-exec-daemon-cpp sources. Run nmake from the daemon directory, run from the repository root, or set DAEMON_CPP_DIR.
!ENDIF
!ENDIF

!IFNDEF BUILD_DIR
BUILD_DIR=$(DAEMON_CPP_DIR)\build
!ENDIF

!IFNDEF CXX
CXX=cl
!ENDIF

MSVC_VARIANT_NATIVE=native
MSVC_VARIANT_XP=xp

!IFNDEF MSVC_VARIANT
MSVC_VARIANT=$(MSVC_VARIANT_NATIVE)
!ENDIF

MSVC_NATIVE_BINARY_TAG=msvc
MSVC_XP_BINARY_TAG=xp-msvc

MSVC_NATIVE_BIN_DIR=$(BUILD_DIR)\msvc-native
MSVC_NATIVE_OBJ_DIR=$(BUILD_DIR)\obj\msvc-native
MSVC_NATIVE_TEST_OBJ_DIR=$(BUILD_DIR)\obj\msvc-native-test
MSVC_NATIVE_WINPTY_OBJ_DIR=$(BUILD_DIR)\obj\msvc-native-winpty
MSVC_NATIVE_WINPTY_GEN_DIR=$(MSVC_NATIVE_WINPTY_OBJ_DIR)\gen
MSVC_NATIVE_WINPTY_VERSION_HEADER=$(MSVC_NATIVE_WINPTY_GEN_DIR)\GenVersion.h
MSVC_NATIVE_TARGET=$(MSVC_NATIVE_BIN_DIR)\remote-exec-daemon-cpp-$(MSVC_NATIVE_BINARY_TAG).exe
MSVC_NATIVE_WINPTY_AGENT=$(MSVC_NATIVE_BIN_DIR)\winpty-agent.exe

MSVC_XP_BIN_DIR=$(BUILD_DIR)\msvc-xp
MSVC_XP_OBJ_DIR=$(BUILD_DIR)\obj\msvc-xp
MSVC_XP_TEST_OBJ_DIR=$(BUILD_DIR)\obj\msvc-xp-test
MSVC_XP_WINPTY_OBJ_DIR=$(BUILD_DIR)\obj\msvc-xp-winpty
MSVC_XP_WINPTY_GEN_DIR=$(MSVC_XP_WINPTY_OBJ_DIR)\gen
MSVC_XP_WINPTY_VERSION_HEADER=$(MSVC_XP_WINPTY_GEN_DIR)\GenVersion.h
MSVC_XP_TARGET=$(MSVC_XP_BIN_DIR)\remote-exec-daemon-cpp-$(MSVC_XP_BINARY_TAG).exe
MSVC_XP_WINPTY_AGENT=$(MSVC_XP_BIN_DIR)\winpty-agent.exe

!IFNDEF MSVC_XP_WINSDK_DIR
MSVC_XP_WINSDK_DIR=C:\Program Files (x86)\Microsoft SDKs\Windows\v7.1A
!ENDIF

MSVC_COMMON_CPPFLAGS=/I"$(DAEMON_CPP_DIR)\include" /I"$(DAEMON_CPP_DIR)\third_party" \
    /DWIN32 /D_WINDOWS \
    /DWIN32_LEAN_AND_MEAN /DUNICODE /D_UNICODE /DNOMINMAX /D_CRT_SECURE_NO_WARNINGS /D_CRT_NONSTDC_NO_DEPRECATE
MSVC_WINPTY_VENDOR_DIR=$(DAEMON_CPP_DIR)\..\..\winptyrs\crates\winptyrs-sys\vendor\winpty
MSVC_WINPTY_VENDOR_SRC_DIR=$(MSVC_WINPTY_VENDOR_DIR)\src
MSVC_WINPTY_VERSION_TXT=$(MSVC_WINPTY_VENDOR_DIR)\VERSION.txt
MSVC_WINPTY_VENDOR_CPPFLAGS=/I"$(MSVC_WINPTY_VENDOR_SRC_DIR)\include" /I"$(MSVC_WINPTY_VENDOR_SRC_DIR)"
MSVC_WINPTY_LIB_SRCS= \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\libwinpty\AgentLocation.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\libwinpty\winpty.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\BackgroundDesktop.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\Buffer.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\DebugClient.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\GenRandom.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\OwnedHandle.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\StringUtil.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WindowsSecurity.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WindowsVersion.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WinptyAssert.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WinptyException.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WinptyVersion.cc
MSVC_WINPTY_AGENT_SRCS= \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\Agent.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\AgentCreateDesktop.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\ConsoleFont.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\ConsoleInput.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\ConsoleInputReencoding.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\ConsoleLine.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\DebugShowInput.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\DefaultInputMap.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\EventLoop.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\InputMap.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\LargeConsoleRead.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\NamedPipe.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\Scraper.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\Terminal.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\Win32Console.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\Win32ConsoleBuffer.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\agent\main.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\BackgroundDesktop.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\Buffer.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\ConsoleWindow.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\DebugClient.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\GenRandom.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\OwnedHandle.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\StringUtil.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WindowsSecurity.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WindowsVersion.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WinptyAssert.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WinptyException.cc \
    $(MSVC_WINPTY_VENDOR_SRC_DIR)\shared\WinptyVersion.cc

MSVC_NATIVE_WINPTY_CPPFLAGS=$(MSVC_WINPTY_VENDOR_CPPFLAGS) /I"$(MSVC_NATIVE_WINPTY_GEN_DIR)"
MSVC_NATIVE_CPPFLAGS=$(MSVC_COMMON_CPPFLAGS) $(MSVC_NATIVE_WINPTY_CPPFLAGS) /DREMOTE_EXEC_CPP_HAS_WINPTY /DWINPTY_STATIC
MSVC_NATIVE_TEST_CPPFLAGS=$(MSVC_NATIVE_CPPFLAGS) /DREMOTE_EXEC_CPP_TESTING
MSVC_NATIVE_WINPTY_AGENT_CPPFLAGS=$(MSVC_COMMON_CPPFLAGS) $(MSVC_NATIVE_WINPTY_CPPFLAGS) /DWINPTY_AGENT_ASSERT

MSVC_XP_WINPTY_CPPFLAGS=$(MSVC_WINPTY_VENDOR_CPPFLAGS) /I"$(MSVC_XP_WINPTY_GEN_DIR)"
MSVC_XP_CPPFLAGS=$(MSVC_COMMON_CPPFLAGS) /I"$(MSVC_XP_WINSDK_DIR)\Include" $(MSVC_XP_WINPTY_CPPFLAGS) \
    /DREMOTE_EXEC_CPP_HAS_WINPTY /DWINPTY_STATIC /DWINVER=0x0501 /D_WIN32_WINNT=0x0501 /D_USING_V110_SDK71_
MSVC_XP_TEST_CPPFLAGS=$(MSVC_XP_CPPFLAGS) /DREMOTE_EXEC_CPP_TESTING
MSVC_XP_WINPTY_AGENT_CPPFLAGS=$(MSVC_COMMON_CPPFLAGS) /I"$(MSVC_XP_WINSDK_DIR)\Include" $(MSVC_XP_WINPTY_CPPFLAGS) \
    /DWINPTY_AGENT_ASSERT /D_USING_V110_SDK71_ /DWINVER=0x0501 /D_WIN32_WINNT=0x0501

!IFNDEF DEBUG
DEBUG=0
!ENDIF

!IF "$(DEBUG)" == "1"
MSVC_MODE_CXXFLAGS=/Od /Zi /FS
MSVC_LDDEBUGFLAGS=/DEBUG
!ELSEIF "$(DEBUG)" == "yes"
MSVC_MODE_CXXFLAGS=/Od /Zi /FS
MSVC_LDDEBUGFLAGS=/DEBUG
!ELSEIF "$(DEBUG)" == "true"
MSVC_MODE_CXXFLAGS=/Od /Zi /FS
MSVC_LDDEBUGFLAGS=/DEBUG
!ELSEIF "$(DEBUG)" == "on"
MSVC_MODE_CXXFLAGS=/Od /Zi /FS
MSVC_LDDEBUGFLAGS=/DEBUG
!ELSE
MSVC_MODE_CXXFLAGS=/O2
MSVC_LDDEBUGFLAGS=
!ENDIF

!IFNDEF MSVC_JOBS
MSVC_JOBS=
!ENDIF

!IF "$(MSVC_JOBS)" == ""
MSVC_PARALLEL_CXXFLAGS=/MP
!ELSEIF "$(MSVC_JOBS)" == "0"
MSVC_PARALLEL_CXXFLAGS=
!ELSEIF "$(MSVC_JOBS)" == "1"
MSVC_PARALLEL_CXXFLAGS=
!ELSE
MSVC_PARALLEL_CXXFLAGS=/MP$(MSVC_JOBS)
!ENDIF

MSVC_CXXFLAGS=/nologo /EHsc /MT /W3 $(MSVC_MODE_CXXFLAGS) $(MSVC_PARALLEL_CXXFLAGS) /utf-8 /std:c++14
MSVC_NATIVE_LDLIBS=ws2_32.lib advapi32.lib shell32.lib user32.lib
MSVC_XP_LDLIBS=ws2_32.lib advapi32.lib shell32.lib user32.lib
MSVC_NATIVE_LDFLAGS=/link /NOLOGO /SUBSYSTEM:CONSOLE $(MSVC_LDDEBUGFLAGS)
MSVC_XP_LDFLAGS=/link /NOLOGO /LIBPATH:"$(MSVC_XP_WINSDK_DIR)\Lib" /SUBSYSTEM:CONSOLE,5.01 /MACHINE:X86 $(MSVC_LDDEBUGFLAGS)

MSVC_RUN_TEST=set "REMOTE_EXEC_LOG=$(TEST_LOG_LEVEL)" && "$**"
MSVC_GEN_WINPTY_HEADER=call "$(DAEMON_CPP_DIR)\scripts\write_winpty_version_header.cmd" "$(MSVC_WINPTY_VERSION_TXT)" "$(MSVC_SELECTED_WINPTY_VERSION_HEADER)"

!IFNDEF TEST_LOG_LEVEL
!IFDEF REMOTE_EXEC_LOG
TEST_LOG_LEVEL=$(REMOTE_EXEC_LOG)
!ELSEIFDEF REMOTE_EXEC_TEST_LOG
TEST_LOG_LEVEL=$(REMOTE_EXEC_TEST_LOG)
!ELSE
TEST_LOG_LEVEL=off
!ENDIF
!ENDIF

MSVC_REENTER_BASE=nmake /nologo /f "$(DAEMON_CPP_DIR)\NMakefile" DAEMON_CPP_DIR="$(DAEMON_CPP_DIR)" BUILD_DIR="$(BUILD_DIR)" CXX="$(CXX)" DEBUG="$(DEBUG)" TEST_LOG_LEVEL="$(TEST_LOG_LEVEL)" MSVC_JOBS="$(MSVC_JOBS)"
MSVC_REENTER_NATIVE=$(MSVC_REENTER_BASE) MSVC_VARIANT=$(MSVC_VARIANT_NATIVE)
MSVC_REENTER_XP=$(MSVC_REENTER_BASE) MSVC_VARIANT=$(MSVC_VARIANT_XP) MSVC_XP_WINSDK_DIR="$(MSVC_XP_WINSDK_DIR)"

SOURCE_PREFIX=$(DAEMON_CPP_DIR)/
!include "$(DAEMON_CPP_DIR)\mk\sources.mk"

MSVC_DAEMON_SRCS=$(WINDOWS_DAEMON_SRCS) $(MSVC_WINPTY_LIB_SRCS)
MSVC_BASIC_MUTEX_TEST_SRCS=$(WINDOWS_BASIC_MUTEX_TEST_SRCS)
MSVC_CONSOLE_OUTPUT_TEST_SRCS=$(WINDOWS_CONSOLE_OUTPUT_TEST_SRCS)
MSVC_PATCH_TEST_SRCS=$(WINDOWS_PATCH_TEST_SRCS)
MSVC_SESSION_STORE_TEST_SRCS=$(WINDOWS_SESSION_STORE_TEST_SRCS) $(MSVC_WINPTY_LIB_SRCS)
MSVC_SERVER_STREAMING_TEST_SRCS=$(WINDOWS_SERVER_STREAMING_SRCS) $(MSVC_WINPTY_LIB_SRCS)
MSVC_TRANSFER_TEST_SRCS=$(WINDOWS_TRANSFER_TEST_SRCS)
MSVC_CONFIG_TEST_SRCS=$(WINDOWS_CONFIG_TEST_SRCS)
MSVC_HTTP_REQUEST_TEST_SRCS=$(HOST_HTTP_REQUEST_SRCS)
MSVC_SERVER_TRANSPORT_TEST_SRCS=$(WINDOWS_SERVER_TRANSPORT_TEST_SRCS)
MSVC_CONNECTION_MANAGER_TEST_SRCS=$(WINDOWS_CONNECTION_MANAGER_TEST_SRCS)
MSVC_SERVER_ROUTES_COMMON_TEST_SRCS=$(WINDOWS_SERVER_ROUTES_COMMON_TEST_SRCS) $(MSVC_WINPTY_LIB_SRCS)
MSVC_SERVER_ROUTES_TEST_SRCS=$(WINDOWS_SERVER_ROUTES_TEST_SRCS) $(MSVC_WINPTY_LIB_SRCS)
MSVC_SERVER_RUNTIME_TEST_SRCS=$(WINDOWS_SERVER_RUNTIME_TEST_SRCS) $(MSVC_WINPTY_LIB_SRCS)
MSVC_SANDBOX_TEST_SRCS=$(WINDOWS_SANDBOX_TEST_SRCS)
MSVC_PORT_TUNNEL_FRAME_TEST_SRCS=$(HOST_PORT_TUNNEL_FRAME_SRCS)
MSVC_WINPTY_AGENT_LEGACY_OUTPUTS= \
    "$(DAEMON_CPP_DIR)\Agent.obj" \
    "$(DAEMON_CPP_DIR)\AgentCreateDesktop.obj" \
    "$(DAEMON_CPP_DIR)\BackgroundDesktop.obj" \
    "$(DAEMON_CPP_DIR)\Buffer.obj" \
    "$(DAEMON_CPP_DIR)\ConsoleFont.obj" \
    "$(DAEMON_CPP_DIR)\ConsoleInput.obj" \
    "$(DAEMON_CPP_DIR)\ConsoleInputReencoding.obj" \
    "$(DAEMON_CPP_DIR)\ConsoleLine.obj" \
    "$(DAEMON_CPP_DIR)\DebugClient.obj" \
    "$(DAEMON_CPP_DIR)\DebugShowInput.obj" \
    "$(DAEMON_CPP_DIR)\DefaultInputMap.obj" \
    "$(DAEMON_CPP_DIR)\EventLoop.obj" \
    "$(DAEMON_CPP_DIR)\GenRandom.obj" \
    "$(DAEMON_CPP_DIR)\InputMap.obj" \
    "$(DAEMON_CPP_DIR)\LargeConsoleRead.obj" \
    "$(DAEMON_CPP_DIR)\NamedPipe.obj" \
    "$(DAEMON_CPP_DIR)\OwnedHandle.obj" \
    "$(DAEMON_CPP_DIR)\Scraper.obj" \
    "$(DAEMON_CPP_DIR)\StringUtil.obj" \
    "$(DAEMON_CPP_DIR)\Terminal.obj" \
    "$(DAEMON_CPP_DIR)\Win32Console.obj" \
    "$(DAEMON_CPP_DIR)\Win32ConsoleBuffer.obj" \
    "$(DAEMON_CPP_DIR)\WindowsSecurity.obj" \
    "$(DAEMON_CPP_DIR)\WindowsVersion.obj" \
    "$(DAEMON_CPP_DIR)\WinptyAssert.obj" \
    "$(DAEMON_CPP_DIR)\WinptyException.obj" \
    "$(DAEMON_CPP_DIR)\WinptyVersion.obj" \
    "$(DAEMON_CPP_DIR)\main.obj"

!IF "$(MSVC_VARIANT)" == "$(MSVC_VARIANT_NATIVE)"
MSVC_SELECTED_VARIANT_LABEL=native
MSVC_SELECTED_BINARY_TAG=$(MSVC_NATIVE_BINARY_TAG)
MSVC_SELECTED_BIN_DIR=$(MSVC_NATIVE_BIN_DIR)
MSVC_SELECTED_OBJ_DIR=$(MSVC_NATIVE_OBJ_DIR)
MSVC_SELECTED_TEST_OBJ_DIR=$(MSVC_NATIVE_TEST_OBJ_DIR)
MSVC_SELECTED_WINPTY_OBJ_DIR=$(MSVC_NATIVE_WINPTY_OBJ_DIR)
MSVC_SELECTED_WINPTY_GEN_DIR=$(MSVC_NATIVE_WINPTY_GEN_DIR)
MSVC_SELECTED_WINPTY_VERSION_HEADER=$(MSVC_NATIVE_WINPTY_VERSION_HEADER)
MSVC_SELECTED_TARGET=$(MSVC_NATIVE_TARGET)
MSVC_SELECTED_WINPTY_AGENT=$(MSVC_NATIVE_WINPTY_AGENT)
MSVC_SELECTED_CPPFLAGS=$(MSVC_NATIVE_CPPFLAGS)
MSVC_SELECTED_TEST_CPPFLAGS=$(MSVC_NATIVE_TEST_CPPFLAGS)
MSVC_SELECTED_WINPTY_AGENT_CPPFLAGS=$(MSVC_NATIVE_WINPTY_AGENT_CPPFLAGS)
MSVC_SELECTED_LDLIBS=$(MSVC_NATIVE_LDLIBS)
MSVC_SELECTED_LDFLAGS=$(MSVC_NATIVE_LDFLAGS)
!ELSEIF "$(MSVC_VARIANT)" == "$(MSVC_VARIANT_XP)"
MSVC_SELECTED_VARIANT_LABEL=xp
MSVC_SELECTED_BINARY_TAG=$(MSVC_XP_BINARY_TAG)
MSVC_SELECTED_BIN_DIR=$(MSVC_XP_BIN_DIR)
MSVC_SELECTED_OBJ_DIR=$(MSVC_XP_OBJ_DIR)
MSVC_SELECTED_TEST_OBJ_DIR=$(MSVC_XP_TEST_OBJ_DIR)
MSVC_SELECTED_WINPTY_OBJ_DIR=$(MSVC_XP_WINPTY_OBJ_DIR)
MSVC_SELECTED_WINPTY_GEN_DIR=$(MSVC_XP_WINPTY_GEN_DIR)
MSVC_SELECTED_WINPTY_VERSION_HEADER=$(MSVC_XP_WINPTY_VERSION_HEADER)
MSVC_SELECTED_TARGET=$(MSVC_XP_TARGET)
MSVC_SELECTED_WINPTY_AGENT=$(MSVC_XP_WINPTY_AGENT)
MSVC_SELECTED_CPPFLAGS=$(MSVC_XP_CPPFLAGS)
MSVC_SELECTED_TEST_CPPFLAGS=$(MSVC_XP_TEST_CPPFLAGS)
MSVC_SELECTED_WINPTY_AGENT_CPPFLAGS=$(MSVC_XP_WINPTY_AGENT_CPPFLAGS)
MSVC_SELECTED_LDLIBS=$(MSVC_XP_LDLIBS)
MSVC_SELECTED_LDFLAGS=$(MSVC_XP_LDFLAGS)
!ELSE
!ERROR Unsupported MSVC_VARIANT '$(MSVC_VARIANT)'; use 'native' or 'xp'.
!ENDIF

MSVC_ENSURE_SELECTED_BIN_DIR=if not exist "$(MSVC_SELECTED_BIN_DIR)" mkdir "$(MSVC_SELECTED_BIN_DIR)"
MSVC_ENSURE_SELECTED_OBJ_DIR=if not exist "$(MSVC_SELECTED_OBJ_DIR)" mkdir "$(MSVC_SELECTED_OBJ_DIR)"
MSVC_ENSURE_SELECTED_TEST_OBJ_DIR=if not exist "$(MSVC_SELECTED_TEST_OBJ_DIR)" mkdir "$(MSVC_SELECTED_TEST_OBJ_DIR)"
MSVC_ENSURE_SELECTED_WINPTY_OBJ_DIR=if not exist "$(MSVC_SELECTED_WINPTY_OBJ_DIR)" mkdir "$(MSVC_SELECTED_WINPTY_OBJ_DIR)"

MSVC_BUILD_SELECTED_PREFIX=$(CXX) $(MSVC_CXXFLAGS) $(MSVC_SELECTED_CPPFLAGS) /Fd$(MSVC_SELECTED_OBJ_DIR)\vc$(MSVC_SELECTED_BINARY_TAG).pdb /Fo$(MSVC_SELECTED_OBJ_DIR)\ /Fe"$@"
MSVC_BUILD_SELECTED_TEST_PREFIX=$(CXX) $(MSVC_CXXFLAGS) $(MSVC_SELECTED_TEST_CPPFLAGS) /Fd$(MSVC_SELECTED_TEST_OBJ_DIR)\vc$(MSVC_SELECTED_BINARY_TAG)-test.pdb /Fo$(MSVC_SELECTED_TEST_OBJ_DIR)\ /Fe"$@"
MSVC_BUILD_SELECTED_WINPTY_AGENT_PREFIX=$(CXX) $(MSVC_CXXFLAGS) $(MSVC_SELECTED_WINPTY_AGENT_CPPFLAGS) /Fd$(MSVC_SELECTED_WINPTY_OBJ_DIR)\vc$(MSVC_SELECTED_BINARY_TAG)-winpty.pdb /Fo$(MSVC_SELECTED_WINPTY_OBJ_DIR)\ /Fe"$(MSVC_SELECTED_WINPTY_AGENT)"

MSVC_BASIC_MUTEX_TEST=$(MSVC_SELECTED_BIN_DIR)\test_basic_mutex-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_CONSOLE_OUTPUT_TEST=$(MSVC_SELECTED_BIN_DIR)\test_console_output-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_PATCH_TEST=$(MSVC_SELECTED_BIN_DIR)\test_patch-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_SESSION_STORE_TEST=$(MSVC_SELECTED_BIN_DIR)\test_session_store-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_SERVER_STREAMING_TEST=$(MSVC_SELECTED_BIN_DIR)\test_server_streaming-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_TRANSFER_TEST=$(MSVC_SELECTED_BIN_DIR)\test_transfer-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_CONFIG_TEST=$(MSVC_SELECTED_BIN_DIR)\test_config-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_HTTP_REQUEST_TEST=$(MSVC_SELECTED_BIN_DIR)\test_http_request-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_SERVER_TRANSPORT_TEST=$(MSVC_SELECTED_BIN_DIR)\test_server_transport-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_CONNECTION_MANAGER_TEST=$(MSVC_SELECTED_BIN_DIR)\test_connection_manager-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_SERVER_ROUTES_COMMON_TEST=$(MSVC_SELECTED_BIN_DIR)\test_server_routes_common-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_SERVER_ROUTES_TEST=$(MSVC_SELECTED_BIN_DIR)\test_server_routes-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_SERVER_RUNTIME_TEST=$(MSVC_SELECTED_BIN_DIR)\test_server_runtime-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_SANDBOX_TEST=$(MSVC_SELECTED_BIN_DIR)\test_sandbox-$(MSVC_SELECTED_BINARY_TAG).exe
MSVC_PORT_TUNNEL_FRAME_TEST=$(MSVC_SELECTED_BIN_DIR)\test_port_tunnel_frame-$(MSVC_SELECTED_BINARY_TAG).exe

MSVC_TEST_PHONY_TARGETS= \
    test-msvc-basic-mutex \
    test-msvc-console-output \
    test-msvc-patch \
    test-msvc-session-store \
    test-msvc-server-streaming \
    test-msvc-transfer \
    test-msvc-config \
    test-msvc-http-request \
    test-msvc-server-transport \
    test-msvc-connection-manager \
    test-msvc-server-routes-common \
    test-msvc-server-routes \
    test-msvc-server-runtime \
    test-msvc-sandbox \
    test-msvc-port-tunnel-frame

all: all-msvc-native

all-msvc: $(MSVC_SELECTED_TARGET)

test-msvc: $(MSVC_TEST_PHONY_TARGETS)

